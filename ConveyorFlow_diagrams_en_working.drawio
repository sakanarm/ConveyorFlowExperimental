        <mxCell id="v23title" parent="1" vertex="1" value="ConveyorFlow v2.3 matched decision path" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#65798A;fontColor=#172D3E;fontFamily=Arial;fontSize=31;fontStyle=1;align=center;verticalAlign=middle;"><mxGeometry x="30" y="15" width="1340" height="60" as="geometry"/></mxCell>
        <mxCell id="v23belt" parent="1" vertex="1" value="Shared READY belt&#xa;Same frontier, agents, fit, stand-down, retry rules and verifier" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF6FD;strokeColor=#65798A;fontColor=#172D3E;fontFamily=Arial;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;"><mxGeometry x="65" y="105" width="1270" height="95" as="geometry"/></mxCell>
        <mxCell id="v23local" parent="1" vertex="1" value="CF-Fit&#xa;Each idle agent chooses one local bid" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF8EE;strokeColor=#65798A;fontColor=#172D3E;fontFamily=Arial;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;"><mxGeometry x="60" y="245" width="370" height="110" as="geometry"/></mxCell>
        <mxCell id="v23matched" parent="1" vertex="1" value="Central-Matched&#xa;The same one local bid per idle agent" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF4DF;strokeColor=#65798A;fontColor=#172D3E;fontFamily=Arial;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;"><mxGeometry x="515" y="245" width="370" height="110" as="geometry"/></mxCell>
        <mxCell id="v23static" parent="1" vertex="1" value="Static S3&#xa;Stage ownership fixed before execution" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F0F0F0;strokeColor=#65798A;fontColor=#172D3E;fontFamily=Arial;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;"><mxGeometry x="970" y="245" width="370" height="110" as="geometry"/></mxCell>
        <mxCell id="v23direct" parent="1" vertex="1" value="Direct claim&#xa;No central agent-task matcher" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF8EE;strokeColor=#65798A;fontColor=#172D3E;fontFamily=Arial;fontSize=24;fontStyle=0;align=center;verticalAlign=middle;"><mxGeometry x="60" y="405" width="370" height="90" as="geometry"/></mxCell>
        <mxCell id="v23relay" parent="1" vertex="1" value="Coordinator relay&#xa;Cannot add candidates or rerank" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF4DF;strokeColor=#65798A;fontColor=#172D3E;fontFamily=Arial;fontSize=24;fontStyle=0;align=center;verticalAlign=middle;"><mxGeometry x="515" y="405" width="370" height="90" as="geometry"/></mxCell>
        <mxCell id="v23owner" parent="1" vertex="1" value="Idle owner takes its&#xa;own dependency-ready stage" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F0F0F0;strokeColor=#65798A;fontColor=#172D3E;fontFamily=Arial;fontSize=24;fontStyle=0;align=center;verticalAlign=middle;"><mxGeometry x="970" y="405" width="370" height="90" as="geometry"/></mxCell>
        <mxCell id="v23claim" parent="1" vertex="1" value="Shared claim store and execution / verification&#xa;CF-Fit removes the coordinator from its path, not the shared store" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF6FD;strokeColor=#65798A;fontColor=#172D3E;fontFamily=Arial;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;"><mxGeometry x="65" y="550" width="1270" height="95" as="geometry"/></mxCell>
        <mxCell id="v23note" parent="1" vertex="1" value="Zero-overhead control: CF-Fit and Central-Matched must match&#xa;A coordinator outage affects the relay path; a belt outage affects both&#xa;Static is a separate baseline, not the matched authority control" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#65798A;fontColor=#172D3E;fontFamily=Arial;fontSize=23;fontStyle=0;align=center;verticalAlign=middle;"><mxGeometry x="65" y="700" width="1270" height="100" as="geometry"/></mxCell>
