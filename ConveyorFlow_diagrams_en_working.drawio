          <mxGeometry height="17.1" width="28.8" x="837.9" y="356.40000000000003" as="geometry" />
        </mxCell>
        <mxCell id="n85" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fdf6f2;strokeColor=#a0522d;fontSize=11;fontColor=#26313a;strokeWidth=2;fontStyle=0;dashed=0;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica" value="" vertex="1">
          <mxGeometry height="85" width="522" x="18.9" y="514" as="geometry" />
        </mxCell>
        <mxCell id="n86" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#a0522d;fontStyle=1;fontFamily=Helvetica" value="The cost of this picture is structural, not accidental." vertex="1">
          <mxGeometry height="19.8" width="486" x="36.9" y="515.8" as="geometry" />
        </mxCell>
        <mxCell id="n87" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=8.5;fontColor=#26313a;fontStyle=0;fontFamily=Helvetica" value="One agent is idle while one READY task is queued for a busy owner. No mechanism&lt;br&gt;in this system can connect them, and the deadlock guard is forbidden from doing it:&lt;br&gt;handing T04 to whoever happens to be free would turn the baseline into a dynamic&lt;br&gt;policy and flatter it. A task waiting for its owner is the defining structural cost&lt;br&gt;of static assignment, and it is the cost this research is trying to remove." vertex="1">
          <mxGeometry height="50.4" width="486" x="36.9" y="537.4" as="geometry" />
        </mxCell>
        <mxCell id="n88" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#8fa2b3;fontSize=11;fontColor=#26313a;strokeWidth=2;fontStyle=0;dashed=0;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica" value="" vertex="1">
          <mxGeometry height="88" width="522" x="576.9" y="514" as="geometry" />
        </mxCell>
        <mxCell id="n89" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#3f6f9f;fontStyle=1;fontFamily=Helvetica" value="Identical workload. The only thing that changes is who decides." vertex="1">
          <mxGeometry height="19.8" width="486" x="594.9" y="515.8" as="geometry" />
        </mxCell>
        <mxCell id="n90" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=8.5;fontColor=#26313a;fontStyle=0;fontFamily=Helvetica" value="Same job, same DAG, same READY rule, same one-task-per-agent limit, same belt.&lt;br&gt;Everything above the belt is copied from the ConveyorFlow sheets unchanged.&lt;br&gt;collision_rate = 0 on every sheet in this family, and that is not an efficiency&lt;br&gt;result: nobody contends because somebody already decided." vertex="1">
          <mxGeometry height="50.4" width="486" x="594.9" y="537.4" as="geometry" />
        </mxCell>
        <mxCell id="ufCyCDXi9dJuTzYtInnU-4" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=8;fontColor=#a0522d;fontStyle=1;fontFamily=Helvetica" value="The planner is currently assigning T04. The next task must wait until the previous assignment is completed." vertex="1">
          <mxGeometry height="26.1" width="127.8" x="275.4" y="270.9" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
