  <diagram id="cf-process" name="Figure 2 ConveyorFlow process architecture">
    <mxGraphModel dx="1700" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="CONVEYORFLOW PROCESS ARCHITECTURE IN THE SIMULATION" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="180" y="25" width="1340" height="55" as="geometry" /></mxCell>
        <mxCell id="gate" value="Job arrives&#10;Predecessors VERIFIED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#44719C;fontFamily=Arial;fontSize=21;spacing=12;" vertex="1" parent="1"><mxGeometry x="55" y="150" width="300" height="145" as="geometry" /></mxCell>
        <mxCell id="belt" value="READY belt&#10;Task waits in bounded visible window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4F3;strokeColor=#4E8D86;fontFamily=Arial;fontSize=21;spacing=12;" vertex="1" parent="1"><mxGeometry x="435" y="150" width="330" height="145" as="geometry" /></mxCell>
        <mxCell id="agents" value="Idle Ability Rank 1 / 2 / 3 agents&lt;br&gt;Local fit check: one volunteer bid or lower priority when overqualified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F0DD;strokeColor=#B18A33;fontFamily=Arial;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="845" y="125" width="390" height="195" as="geometry" /></mxCell>
        <mxCell id="claims" value="Atomic claim: ordered nonconflicting bids&lt;br&gt;No global fit matcher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#44719C;fontFamily=Arial;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="1315" y="150" width="330" height="145" as="geometry" /></mxCell>
        <mxCell id="execute" value="RUNNING -&amp;gt; deterministic outcome -&amp;gt; verification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4F3;strokeColor=#4E8D86;fontFamily=Arial;fontSize=21;spacing=12;" vertex="1" parent="1"><mxGeometry x="1065" y="435" width="500" height="120" as="geometry" /></mxCell>
        <mxCell id="retry" value="No bid or failed attempt: return to READY while allowed; age/requeue, then DEAD_LETTER at bound" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E9;strokeColor=#C68149;fontFamily=Arial;fontSize=19;spacing=12;" vertex="1" parent="1"><mxGeometry x="55" y="435" width="620" height="120" as="geometry" /></mxCell>
        <mxCell id="success" value="VERIFIED -&amp;gt; append-only event ledger; release successors; all verified -&amp;gt; job complete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4F3;strokeColor=#4E8D86;fontFamily=Arial;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="820" y="690" width="745" height="100" as="geometry" /></mxCell>
        <mxCell id="horizon" value="At fixed horizon H, remaining nonterminal tasks are UNSETTLED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FA;strokeColor=#8A72B1;fontFamily=Arial;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="55" y="690" width="625" height="100" as="geometry" /></mxCell>
        <mxCell id="e1" style="endArrow=block;html=1;strokeColor=#44719C;strokeWidth=3;" edge="1" parent="1" source="gate" target="belt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeColor=#4E8D86;strokeWidth=3;" edge="1" parent="1" source="belt" target="agents"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeColor=#B18A33;strokeWidth=3;" edge="1" parent="1" source="agents" target="claims"><mxGeometry relative="1" as="geometry" /></mxCell>
