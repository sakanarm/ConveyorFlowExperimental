        <mxCell id="n84" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fdf6f2;strokeColor=#2c7fb8;fontSize=11;fontColor=#26313a;strokeWidth=2;fontStyle=0;dashed=0;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica" value="" vertex="1">
          <mxGeometry height="77.4" width="522" x="18" y="504" as="geometry" />
        </mxCell>
        <mxCell id="n85" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#2c7fb8;fontStyle=1;fontFamily=Helvetica" value="HEFT is not free. It is bought with information." vertex="1">
          <mxGeometry height="19.8" width="486" x="36" y="505.8" as="geometry" />
        </mxCell>
        <mxCell id="n86" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=8.5;fontColor=#26313a;fontStyle=0;fontFamily=Helvetica" value="The scheduler needs the whole DAG, including tasks nobody has seen yet, and every agent's&lt;br&gt;published capability vector. rank_u is built from base_effort read off the job spec, because&lt;br&gt;ranking BLOCKED tasks means ranking tasks no agent has estimated - knowledge ConveyorFlow&lt;br&gt;never collects, and the paper states that asymmetry rather than claiming a parity it lacks.&lt;br&gt;On the READY set HEFT uses the agents' own estimates, so selection carries P3's noise too." vertex="1">
          <mxGeometry height="50.4" width="486" x="36" y="527.4" as="geometry" />
        </mxCell>
        <mxCell id="n87" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#8fa2b3;fontSize=11;fontColor=#26313a;strokeWidth=2;fontStyle=0;dashed=0;align=center;verticalAlign=middle;spacing=4;fontFamily=Helvetica" value="" vertex="1">
          <mxGeometry height="77.4" width="522" x="576" y="504" as="geometry" />
        </mxCell>
        <mxCell id="n88" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#3f6f9f;fontStyle=1;fontFamily=Helvetica" value="Identical workload. The only thing that changes is who decides." vertex="1">
          <mxGeometry height="19.8" width="486" x="594" y="505.8" as="geometry" />
        </mxCell>
        <mxCell id="n89" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=8.5;fontColor=#26313a;fontStyle=0;fontFamily=Helvetica" value="Same job, same DAG, same READY rule, same one-task-per-agent limit, same belt.&lt;br&gt;Everything above the belt is copied from the ConveyorFlow sheets unchanged.&lt;br&gt;collision_rate = 0 on every sheet in this family, and that is not an efficiency&lt;br&gt;result: nobody contends because somebody already decided." vertex="1">
          <mxGeometry height="50.4" width="486" x="594" y="527.4" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Baseline - Round-robin (P8)" id="5">
    <mxGraphModel dx="1324" dy="652" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
