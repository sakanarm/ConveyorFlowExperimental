  <diagram name="AJSTR v2.3 | Matched decision paths" id="ajstr-v23-matched-paths">
    <mxGraphModel page="1" pageScale="1" pageWidth="1400" pageHeight="830" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
