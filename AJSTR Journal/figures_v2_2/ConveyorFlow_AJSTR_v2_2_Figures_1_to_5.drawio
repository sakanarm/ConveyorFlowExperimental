<diagram id="cf-fit" name="Figure 3 CF-Fit volunteer belt"><mxGraphModel dx="1500" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="730" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="CF-Fit: tasks ride the belt; agents volunteer" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#17324D;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1400" height="45" as="geometry" /></mxCell><mxCell id="arrival" value="Task arrives" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;glass=0;fillColor=#ECF2F8;strokeColor=#607589;fontColor=#17324D;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="170" height="75" as="geometry" /></mxCell><mxCell id="gate" value="Dependencies&lt;br&gt;verified?" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;glass=0;fillColor=#ECF2F8;strokeColor=#607589;fontColor=#17324D;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="250" y="105" width="180" height="75" as="geometry" /></mxCell><mxCell id="belt" value="READY belt&lt;br&gt;&lt;font style='font-size:15px'&gt;ordered dependency-ready tasks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;glass=0;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="470" y="95" width="360" height="95" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#53718B;" edge="1" parent="1" source="arrival" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#53718B;" edge="1" parent="1" source="gate" target="belt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="window" value="Each idle agent scans&lt;br&gt;up to 8 belt tasks" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;glass=0;fillColor=#E5F6F1;strokeColor=#4F9D84;fontColor=#17324D;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="470" y="245" width="360" height="75" as="geometry" /></mxCell><mxCell id="a1" value="Rank 1&lt;br&gt;local fit check" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;glass=0;fillColor=#E5F6F1;strokeColor=#4F9D84;fontColor=#17324D;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="230" y="390" width="245" height="70" as="geometry" /></mxCell><mxCell id="a2" value="Rank 2&lt;br&gt;local fit check" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;glass=0;fillColor=#E5F6F1;strokeColor=#4F9D84;fontColor=#17324D;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="510" y="390" width="245" height="70" as="geometry" /></mxCell><mxCell id="a3" value="Rank 3&lt;br&gt;fit or lower priority" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;glass=0;fillColor=#E5F6F1;strokeColor=#4F9D84;fontColor=#17324D;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="790" y="390" width="245" height="70" as="geometry" /></mxCell><mxCell id="claim" value="Atomic claim resolves a race" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;glass=0;fillColor=#FFF0DD;strokeColor=#CC8B3D;fontColor=#5E3B13;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="565" y="530" width="295" height="70" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#53718B;" edge="1" parent="1" source="belt" target="window"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#53718B;" edge="1" parent="1" source="window" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#53718B;" edge="1" parent="1" source="window" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#53718B;" edge="1" parent="1" source="window" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#53718B;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="claim"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="352" y="495" /><mxPoint x="624" y="495" /></Array></mxGeometry></mxCell><mxCell id="c2" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#53718B;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="claim"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="632" y="495" /><mxPoint x="712" y="495" /></Array></mxGeometry></mxCell><mxCell id="c3" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#53718B;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" paren