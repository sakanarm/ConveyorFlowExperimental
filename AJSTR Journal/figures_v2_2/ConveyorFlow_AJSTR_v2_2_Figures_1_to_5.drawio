lue="Dependencies&lt;br&gt;verified?" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;glass=0;fillColor=#ECF2F8;strokeColor=#607589;fontColor=#17324D;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="250" y="105" width="180" height="75" as="geometry" /></mxCell><mxCell id="belt" value="READY belt&lt;br&gt;&lt;font style='font-size:15px'&gt;ordered dependency-ready tasks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;glass=0;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="470" y="95" width="360" height="95" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#53718B;" edge="1" parent="1" source="arrival" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#53718B;" edge="1" parent="1" source="gate" target="belt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rule" value="Ownership rule fixed&lt;br&gt;before the run" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;glass=0;fillColor=#FFF0DD;strokeColor=#CC8B3D;fontColor=#5E3B13;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="470" y="245" width="360" height="75" as="geometry" /></mxCell><mxCell id="a1" value="Idle agent 1&lt;br&gt;takes mapped task" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;glass=0;fillColor=#E5F6F1;strokeColor=#4F9D84;fontColor=#17324D;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="290" y="385" width="270" height="76" as="geometry" /></mxCell><mxCell id="a2" value="Idle agent 2&lt;br&gt;takes mapped task" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;glass=0;fillColor=#E5F6F1;strokeColor=#4F9D84;fontColor=#17324D;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="615" y="385" width="270" height="76" as="geometry" /></mxCell><mxCell id="a3" value="Idle agent 3&lt;br&gt;takes mapped task" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;glass=0;fillColor=#E5F6F1;strokeColor=#4F9D84;fontColor=#17324D;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="940" y="385" width="270" height="76" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#53718B;" edge="1" parent="1" source="belt" target="rule"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#53718B;" edge="1" parent="1" source="rule" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#53718B;" edge="1" parent="1" source="rule" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#53718B;" edge="1" parent="1" source="rule" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note" value="All free agents may start their assigned READY work in the same tick. There is no serial run-time planner and no volunteering." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#405366;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="70" y="515" width="1340" height="46" as="geometry" /></mxCell><mxCell id="shared" value="Shared downstream steps: execute  →  deterministic verification  →  VERIFIED or bounded retry / terminal accounting" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#405366;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="875" y="92" width="570" height="105" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="cf-tick" name="Figure 5 One simulation tick">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="ONE SIMULATION TICK (FIXED HORIZON H)" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="130" y="35" width="1340" height="50" as="geometry" /></mxCell>
        <mxCell id="a" value="1  COLLECT&#10;Finish running tasks; verify outcomes; release agent slots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#44719C;fontFamily=Arial;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="300" height="145" as="geometry" /></mxCell>
        <mxCell id="b" value="2  ADMIT&#10;Add arrived jobs and newly dependency-ready tasks to belt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4F3;strokeColor=#4E8D86;fontFamily=Arial;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="450" y="150" width="300" height="145" as="geometry" /></mxCell>
        <mxCell id="c" value="3  ALLOCATE&#10;CF-Fit: local assessments + ordered bids&#10;Static / Central-Fit: their own rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F0DD;strokeColor=#B18A33;fontFamily=Arial;fontSize=19;spacing=12;" vertex="1" parent="1"><mxGeometry x="840" y="140" width="340" height="165" as="geometry" /></mxCell>
        <mxCell id="d" value="4  ACCOUNT&#10;Start winners at this tick; record queue, busy and idle time, and events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FA;strokeColor=#44719C;fontFamily=Arial;fontSize=19;spacing=12;" vertex="1" parent="1"><mxGeometry x="1260" y="150" width="300" height="145" as="geometry" /></mxCell>
        <mxCell id="fallback" value="No volunteer under dynamic policies: keep READY, relax eligibility with age, then retry or mark DEAD_LETTER at bound. Static policy follows its fixed owner rule." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E9;strokeColor=#C68149;fontFamily=Arial;fontSize=19;spacing=12;" vertex="1" parent="1"><mxGeometry x="410" y="435" width="790" height="120" as="geometry" /></mxCell>
        <mxCell id="end" value="At H: remaining nonterminal tasks → UNSETTLED; reconstruct metrics from the event ledger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FA;strokeColor=#8A72B1;fontFamily=Arial;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="410" y="675" width="790" height="100" as="geometry" /></mxCell>
        <mxCell id="ab" style="endArrow=block;html=1;strokeColor=#44719C;strokeWidth=3;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="bc" style="endArrow=block;html=1;strokeColor=#4E8D86;strokeWidth=3;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cd" style="endArrow=block;html=1;strokeColor=#B18A33;strokeWidth=3;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cf" style="endArrow=block;html=1;strokeColor=#C68149;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c" target="fallback"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe" style="endArrow=block;html=1;strokeColor=#8A72B1;strokeWidth=2;" edge="1" parent="1" source="fallback" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
